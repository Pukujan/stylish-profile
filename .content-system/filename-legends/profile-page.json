{
  "schema_version": "content-generation.filename-legend.v1",
  "feature": "profile-page",
  "glossary": [
    {
      "token": "Loose Ends",
      "meaning": "the pile of unwritten decisions and unrun checks that a long project drops when nobody keeps a trail"
    },
    {
      "token": "Badge Wall",
      "meaning": "a page whose loudest element is a third-party statistics card, so it says nothing about what the projects do"
    },
    {
      "token": "Thread",
      "meaning": "the single habit that runs through all three featured repositories"
    },
    {
      "token": "Check",
      "meaning": "a claim on the page that a reader can verify against a public repository"
    },
    {
      "token": "Motion",
      "meaning": "a short looping animation whose frames were generated one at a time from the previous frame"
    },
    {
      "token": "Generated chart",
      "meaning": "an SVG drawn by scripts/track_activity.py from live GitHub data on the daily schedule, not an illustration"
    },
    {
      "token": "Phone",
      "meaning": "the variant served to screens 640 pixels wide or narrower through a picture element"
    },
    {
      "token": "Dark",
      "meaning": "a dark-mode copy of an asset, derived from its light original by scripts/derive_dark_assets.py rather than generated by a model, so the two keep identical shapes and differ only in colour"
    },
    {
      "token": "Ping-pong",
      "meaning": "a loop order that plays the generated frames forward then backward, so a three-frame animation returns to its first frame without a visible snap"
    },
    {
      "token": "Derived",
      "meaning": "an asset produced from another committed asset by a committed script, not by a generation call; it can be re-created from its source and carries no prompt of its own"
    },
    {
      "token": "Avatar",
      "meaning": "the account profile picture, drawn as the same character who appears in the page illustrations"
    }
  ],
